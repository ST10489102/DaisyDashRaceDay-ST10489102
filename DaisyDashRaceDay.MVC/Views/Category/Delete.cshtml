@model DaisyDashRaceDay.MVC.Models.CategoryViewModel
@{
    ViewData["Title"] = "Delete Category";
}

<h2>Delete Category</h2>
<h4 class="text-danger">Are you sure you want to delete this category?</h4>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Event Id:</strong> @Model.EventId</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="eventId" value="@Model.EventId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-secondary">Cancel</a>
</form>