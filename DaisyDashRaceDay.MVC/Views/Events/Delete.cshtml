@model DaisyDashRaceDay.MVC.Models.EventViewModel
@{
    ViewData["Title"] = "Delete Event";
}

<h2>Delete Event</h2>
<h4 class="text-danger">Are you sure you want to delete this event?</h4>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Date:</strong> @Model.Date.ToString("dd MMM yyyy")</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Type:</strong> @Model.EventType</p>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p><strong>Description:</strong><br />@Model.Description</p>
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>