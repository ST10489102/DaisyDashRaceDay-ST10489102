@model DaisyDashRaceDay.MVC.Models.EventViewModel
@{
    ViewData["Title"] = "Event Details";
}
<h2>@Model.Name</h2>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Date.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-2">Location</dt>
    <dd class="col-sm-10">@Model.Location</dd>
    <dt class="col-sm-2">Distance</dt>
    <dd class="col-sm-10">@Model.Distance km</dd>
    <dt class="col-sm-2">Entry Fee</dt>
    <dd class="col-sm-10">R @Model.EntryFee</dd>
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">Enrolments</dt>
    <dd class="col-sm-10">@Model.EnrolmentCount</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>