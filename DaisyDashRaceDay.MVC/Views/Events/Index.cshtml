@model List<DaisyDashRaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Events";
}

<h2>Events</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Create Event</a>

@if (Model == null || !Model.Any())
{
    <p>No events yet. Create one!</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Location</th>
                <th style="width: 380px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.Location</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        <a asp-controller="Entry" asp-action="Index" asp-route-eventId="@item.Id" class="btn btn-info btn-sm">Entries</a>
                        <a asp-controller="Result" asp-action="Index" asp-route-eventId="@item.Id" class="btn btn-success btn-sm">Results</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}