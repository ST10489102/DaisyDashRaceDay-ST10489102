@model DaisyDashRaceDay.MVC.Models.EntryViewModel
@{
    ViewData["Title"] = "Delete Entry";
}

<h2>Delete Entry</h2>
<h4 class="text-danger">Are you sure you want to delete this entry?</h4>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Participant:</strong> @Model.ParticipantName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Category:</strong> @Model.CategoryName</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="eventId" value="@Model.EventId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-secondary">Cancel</a>
</form>