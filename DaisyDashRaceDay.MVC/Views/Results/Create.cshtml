@model DaisyDashRaceDay.MVC.Models.ResultsViewModel
@{
    ViewData["Title"] = "Add Result";
}

<h2>Add Result</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="EventId" />

    <div class="mb-3">
        <label asp-for="EntryId" class="form-label"></label>
        <select asp-for="EntryId" class="form-select">
            <option value="">-- Select Participant --</option>
            @foreach (var e in Model.Entries)
            {
                <option value="@e.Id">@e.ParticipantName (@e.CategoryName)</option>
            }
        </select>
        <span asp-validation-for="EntryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Position" class="form-label"></label>
        <input asp-for="Position" type="number" class="form-control" placeholder="1" />
        <span asp-validation-for="Position" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FinishTime" class="form-label"></label>
        <input asp-for="FinishTime" class="form-control" placeholder="00:42:15" />
        <span asp-validation-for="FinishTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Result</button>
    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}